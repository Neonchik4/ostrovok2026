# Production: hostname only, without https:// or a path. DNS must point to the VPS.
DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# Google AI Studio API Key(и)
# Получить ключ: https://aistudio.google.com/
# Один ключ или несколько через запятую (с разных проектов AI Studio — у каждого своя
# независимая квота RPM/RPD, каскад перебирает их наравне с моделями). Любое количество:
GEMINI_API_KEYS=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Yandex Object Storage (S3) dataset configuration
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET_NAME=ostrovok2026-dataset-b1g8
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
DATASET_VERSION=latest

# Cloudflare AI Gateway (Proxy for Gemini API from RU without VPN)
# Оставить пустым для прямых запросов в Google, либо указать свой Cloudflare Gateway URL
GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/your_account_id/your_gateway_name/google-ai-studio
