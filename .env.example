# Application profile. Local development uses the Doppler `dev` config via
# `bun run dev:dop`; the Docker stack forces APP_ENV=production for containers.
APP_ENV=development

# Production: hostname only, without https:// or a path. DNS must point to the VPS.
DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# Google AI Studio API Key(и)
# Получить ключ: https://aistudio.google.com/
# Один ключ или несколько через запятую (с разных проектов AI Studio — у каждого своя
# независимая квота RPM/RPD, каскад перебирает их наравне с моделями). Любое количество:
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Курс USD → RUB для окна Request Cost (стоимость запросов к LLM). Не задан — рубли не
# показываются. Пример — курс ЦБ РФ на 28.10.2026. Цены моделей —
# backend/app/data/llm_pricing.json (официальный прайс Gemini API, Paid Tier Standard).
USD_RUB_RATE=80.5307

# Yandex Object Storage (S3) dataset configuration
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET_NAME=ostrovok2026-dataset-b1g8
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
DATASET_VERSION=latest

# Cloudflare AI Gateway (Proxy for Gemini API from RU without VPN)
# Оставить пустым для прямых запросов в Google, либо указать свой Cloudflare Gateway URL
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/your_account_id/your_gateway_name/google-ai-studio
CLOUDFLARE_AI_GATEWAY_TOKEN=cfut_your_api_token_here
CLOUDFLARE_WORKER_URL=https://ostrovok-scraper.your_subdomain.workers.dev

# Database Studio & Admin Access
STUDIO_TEAM_TOKEN=your_team_token_here
DB_ADMIN_TOKEN=your_db_admin_token_here

# PostgreSQL + pgvector (Yandex Cloud Managed PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ostrovok_user:your_password@rc1d-...mdb.yandexcloud.net:6432/ostrovok?sslmode=verify-full

# Travelpayouts / Aviasales API Token (Logistics & Tickets)
# Optional: real flight/train search token
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
