{
  "$schema": "https://unpkg.com/knip@5/overview/config.schema.json",
  "next": {
    "entry": [
      "src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}",
      "next.config.mjs"
    ]
  },
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/shared/ui/**",
    "src/shared/config/**",
    "src/shared/index.ts"
  ],
  "ignoreDependencies": [
    "postcss-load-config",
    "@radix-ui/react-dropdown-menu",
    "@radix-ui/react-select"
  ]
}
