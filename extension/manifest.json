{
  "manifest_version": 3,
  "name": "Ostrovok Muse Copilot",
  "version": "1.0.0",
  "description": "Автономный AI-агент прямого действия для умного поиска и бронирования на Ostrovok.ru",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ostrovok Muse Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.ostrovok.ru/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ostrovok.ru/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "styles.css",
        "styles/*"
      ],
      "matches": [
        "*://*.ostrovok.ru/*"
      ]
    }
  ]
}
